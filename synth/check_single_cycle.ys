# Run from the repository root
# Read only the single cycle CPU and its modules
read_verilog -sv rtl/single_cycle/pc.sv rtl/single_cycle/instruction_memory.sv rtl/single_cycle/register_file.sv rtl/single_cycle/immediate_generator.sv rtl/single_cycle/control_unit.sv rtl/single_cycle/alu_control.sv rtl/single_cycle/alu.sv rtl/single_cycle/data_memory.sv rtl/single_cycle/cpu_top.sv

read_verilog -sv synth/single_cycle_synth_top.sv

# Select the top module and check module connections
hierarchy -check -top single_cycle_synth_top

# Show the design before synthesis
stat
